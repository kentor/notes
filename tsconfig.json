{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "lib": ["DOM", "ES2023"],
    "paths": {
      "App/*": ["./src/js/*"]
    },
    "pretty": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["node", "react", "react-dom"]
  },
  "include": ["src/js", "scripts", "vite.config.ts"]
}
